{
  "fmt": {
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--check"
    ],
    "exit": 0
  },
  "clippy": {
    "command": [
      "cargo",
      "clippy",
      "--workspace",
      "--locked",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  "tests": {
    "command": [
      "cargo",
      "test",
      "--workspace",
      "--locked"
    ],
    "exit": 0
  },
  "build": {
    "command": [
      "cargo",
      "build",
      "--locked"
    ],
    "exit": 0
  },
  "audit": {
    "command": [
      "python3",
      "tools/audit.py"
    ],
    "exit": 0
  },
  "roadmap": {
    "command": [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tools",
      "-p",
      "test_roadmap.py"
    ],
    "exit": 0
  },
  "progress": {
    "command": [
      "python3",
      "tools/sync_progress.py",
      "--check"
    ],
    "exit": 0
  },
  "release": {
    "command": [
      "cargo",
      "build",
      "--release",
      "--locked"
    ],
    "exit": 0
  },
